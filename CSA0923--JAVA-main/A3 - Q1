import java.io.*;

public class Q1ATM {

    static class CardReaderException extends IOException {
        CardReaderException(String message) {
            super(message);
        }
    }

    static void withdraw(String account, String amountText, int balance, boolean cardFileExists)
            throws CardReaderException {

        try {
            if (!cardFileExists) {
                throw new CardReaderException("Card-reader file is missing");
            }

            int amount = Integer.parseInt(amountText);

            if (amount <= 0) {
                throw new IllegalArgumentException("Withdrawal must be positive");
            }

            if (amount > balance) {
                throw new IllegalStateException("Insufficient balance");
            }

            System.out.println("Cash dispensed: " + amount + " for account " + account);

        } catch (NumberFormatException | IllegalStateException exception) {
            System.out.println("Input/transaction error: " + exception.getMessage());

        } catch (IllegalArgumentException exception) {
            System.out.println("Amount error: " + exception.getMessage());

        } catch (CardReaderException exception) {
            System.out.println("Device error: " + exception.getMessage());
            throw exception;

        } finally {
            System.out.println("ATM session closed (finally executed)");
        }
    }

    public static void main(String[] args) {

        Object[][] tests = {
            {"A101", "500", 1000, true},
            {"A102", "abc", 1000, true},
            {"A103", "-10", 1000, true},
            {"A104", "1500", 1000, true},
            {"A105", "100", 1000, false}
        };

        for (int i = 0; i < tests.length; i++) {
            System.out.println("Test " + (i + 1));

            try {
                withdraw(
                        (String) tests[i][0],
                        (String) tests[i][1],
                        (int) tests[i][2],
                        (boolean) tests[i][3]
                );

            } catch (CardReaderException exception) {
                System.out.println("Caller handled: "
                        + exception.getClass().getSimpleName());
            }
        }

        try {
    throw new NullPointerException("Demonstration exception");

} catch (NullPointerException exception) {
    System.out.println(
            "Handled exception: "
            + exception.getClass().getSimpleName()
            + " - "
            + exception.getMessage()
    );
}

System.out.println("All ATM tests completed.");
    }
}
