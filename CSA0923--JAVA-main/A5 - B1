import java.io.*;
import java.nio.file.*;

public class Main {

    static long count(Path p, boolean buffered) throws IOException {
        long lines = 0;
        boolean any = false;
        int last = -1;

        try (InputStream in = buffered
                ? new BufferedInputStream(Files.newInputStream(p), 65536)
                : Files.newInputStream(p)) {

            int b;
            while ((b = in.read()) != -1) {
                any = true;
                last = b;

                if (b == '\n') {
                    lines++;
                }
            }
        }

        if (any && last != '\n') {
            lines++;
        }

        return lines;
    }

    public static void main(String[] args) throws Exception {

        Path p = Paths.get("attendance.log");

        // Create a sample file for testing
        String sample = "Chakritha\nBhavya\nVineetha\nStudent 4\nStudent 5";
        Files.write(p, sample.getBytes());

        long t = System.nanoTime();
        long u = count(p, false);
        long tu = System.nanoTime() - t;

        t = System.nanoTime();
        long b = count(p, true);
        long tb = System.nanoTime() - t;

        System.out.println("File: attendance.log");
        System.out.println("Unbuffered: " + u + " lines, "
                + tu / 1e6 + " ms");

        System.out.println("Buffered: " + b + " lines, "
                + tb / 1e6 + " ms");
    }
}
