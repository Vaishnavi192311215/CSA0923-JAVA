import java.util.*;

public class Q1Strings {

    static volatile int sink;

    static String buildPlus(int fields) {
        String s = "";
        for (int i = 0; i < fields; i++) {
            s += "FIELD" + i + "=" + i + ";";
        }
        return s;
    }

    static String buildBuilder(int fields) {
        StringBuilder b = new StringBuilder();
        for (int i = 0; i < fields; i++) {
            b.append("FIELD").append(i).append('=').append(i).append(';');
        }
        return b.toString();
    }

    static String buildBuffer(int fields) {
        StringBuffer b = new StringBuffer();
        for (int i = 0; i < fields; i++) {
            b.append("FIELD").append(i).append('=').append(i).append(';');
        }
        return b.toString();
    }

    static long measure(int method, int fields, int tickets) {
        long start = System.nanoTime();
        int total = 0;

        for (int t = 0; t < tickets; t++) {
            String s = method == 0 ? buildPlus(fields)
                    : method == 1 ? buildBuilder(fields)
                    : buildBuffer(fields);
            total += s.length();
        }

        sink = total;
        return System.nanoTime() - start;
    }

    public static void main(String[] args) {
        int[][] workloads = {
            {5, 1},
            {50, 10000},
            {200, 2000}
        };

        String[] names = {
            "Short ticket",
            "10,000 tickets x 50 fields",
            "2,000 tickets x 200 fields"
        };

        String[] methods = {
            "String +",
            "StringBuilder",
            "StringBuffer"
        };

        System.out.println("Java=" + System.getProperty("java.version")
                + "; warm-up=2; measured runs=5; average milliseconds");

        for (int w = 0; w < workloads.length; w++) {
            System.out.println("\n" + names[w]
                    + " (fields=" + workloads[w][0]
                    + ", tickets=" + workloads[w][1] + ")");

            for (int m = 0; m < 3; m++) {
                measure(m, workloads[w][0], Math.min(workloads[w][1], 100));

                long sum = 0;
                for (int r = 0; r < 5; r++) {
                    sum += measure(m, workloads[w][0], workloads[w][1]);
                }

                System.out.printf(Locale.US, "%-14s %.3f ms%n",
                        methods[m], sum / 5_000_000.0);
            }
        }

        System.out.println("Estimated intermediate concatenation strings: "
                + "String + creates repeated intermediate results; "
                + "builders keep one mutable buffer plus final String.");
    }
}
